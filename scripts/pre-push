#!/bin/sh
# Outband pre-push hook: scan the commits being pushed for secrets.
# Install: ln -s ../../scripts/pre-push .git/hooks/pre-push
# Works with gitleaks 8.19+ (`gitleaks git`) and older releases (`gitleaks detect`).
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-push: gitleaks is not installed; refusing to push." >&2
    exit 1
fi

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue # deleting a branch
    if [ "$remote_sha" = "$zero" ]; then
        range="origin/master..$local_sha"
        git rev-parse -q --verify origin/master >/dev/null 2>&1 || range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi
    if gitleaks git --help >/dev/null 2>&1; then
        gitleaks git --no-banner --redact --log-opts="$range" . || status=1
    else
        gitleaks detect --source . --no-banner --redact --log-opts="$range" || status=1
    fi
done

if [ "$status" -ne 0 ]; then
    echo "pre-push: gitleaks found possible secrets; push refused." >&2
fi
exit "$status"
